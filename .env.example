# ========== SUPABASE - VARIÁVEIS DE AMBIENTE ==========
# Copie este arquivo para .env e preencha com seus valores reais
# NUNCA commite o arquivo .env (já está no .gitignore)

# URL do projeto Supabase
VITE_SUPABASE_URL=https://seu-projeto.supabase.co

# Chave pública (anônima) - segura para o frontend
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_sua_chave_aqui

# URL do JWKS para verificação de tokens JWT
VITE_SUPABASE_JWKS_URL=https://seu-projeto.supabase.co/auth/v1/.well-known/jwks.json

# ============================================================
# DEPLOY NO VERCEL (produção)
# ============================================================
# O arquivo .env NÃO sobe para o GitHub. Para o site funcionar
# online, configure as MESMAS variáveis acima no painel do Vercel:
#
#   Vercel → seu projeto → Settings → Environment Variables
#
# Adicione (uma por linha):
#   VITE_SUPABASE_URL
#   VITE_SUPABASE_PUBLISHABLE_KEY
#   VITE_SUPABASE_JWKS_URL
#
# Depois de adicionar, faça um novo Deploy (Redeploy) para aplicar.
#
# ⚠️ NÃO adicione a secret key (sb_secret_...) aqui.
# Ela é usada apenas em Edge Functions / backend e nunca deve
# ir para o bundle do navegador.