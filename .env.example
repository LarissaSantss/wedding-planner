# ========== SUPABASE - VARIÁVEIS DE AMBIENTE ==========
# Copie este arquivo para .env e preencha com seus valores reais
# NUNCA commite o arquivo .env (já está no .gitignore)

# URL do projeto Supabase
VITE_SUPABASE_URL=https://seu-projeto.supabase.co

# Chave pública (anônima) - segura para o frontend
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_sua_chave_aqui

# Chave secreta (service role) - ⚠️ APENAS para Edge Functions / backend
# NUNCA exponha esta chave no frontend!
VITE_SUPABASE_SECRET_KEY=sb_secret_sua_chave_aqui

# URL do JWKS para verificação de tokens JWT
VITE_SUPABASE_JWKS_URL=https://seu-projeto.supabase.co/auth/v1/.well-known/jwks.json